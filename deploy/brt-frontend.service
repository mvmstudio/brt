[Unit]
Description=BRT Frontend (Next.js)
Documentation=https://github.com/mvmstudio/brt
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/brt.mvm.st/frontend

Environment="NODE_ENV=production"
Environment="PORT=3000"
Environment="HOSTNAME=0.0.0.0"
Environment="NEXT_PUBLIC_API_URL=https://brt.mvm.st"

ExecStart=/usr/local/bin/npx next start -p 3000

Restart=always
RestartSec=10
StartLimitInterval=200
StartLimitBurst=5

NoNewPrivileges=true
PrivateTmp=true

MemoryMax=512M
CPUQuota=30%

StandardOutput=journal
StandardError=journal
SyslogIdentifier=brt-frontend

KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
